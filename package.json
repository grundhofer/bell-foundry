{
  "name": "bell-foundry",
  "private": true,
  "type": "module",
  "description": "The Bell Foundry: a browser duel (three.js, no build step) played with a real sword and shield.",
  "scripts": {
    "serve": "node tools/serve.mjs",
    "test": "node --import ./tests/support/register.mjs --test",
    "regress": "node tools/regress.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc -p jsconfig.json",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "@types/three": "0.186.0",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "pixelmatch": "8.0.0",
    "playwright": "1.65.1",
    "pngjs": "7.0.0",
    "prettier": "3.10.1",
    "typescript": "7.0.2"
  }
}
