{
  // Type checking for the game's JavaScript (no build step): files that start with `// @ts-check` are checked by
  // `npm run typecheck`; the rest is only inferred. Types come from JSDoc comments.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "strict": false,
    "skipLibCheck": true,
    "types": [],
    "paths": {
      "three": ["./node_modules/@types/three/index.d.ts"],
      "three/addons/*": ["./node_modules/@types/three/examples/jsm/*"]
    }
  },
  "include": ["game/src/**/*.js"],
  "exclude": ["game/vendor", "node_modules"]
}
